---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Screen {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
}

interface Props {
  screens: Screen[];
  eager?: boolean;
}

const { screens, eager = false } = Astro.props;
---

<div class="phone">
  <div class="screen">
    {
      screens.map((s, i) => (
        <div class="shot">
          <Image
            class="light"
            src={s.light}
            alt={s.alt}
            widths={[240, 360, 480]}
            sizes="(min-width: 48rem) 17rem, 14rem"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
          />
          <Image class="dark" src={s.dark} alt="" widths={[240, 360, 480]} sizes="(min-width: 48rem) 17rem, 14rem" loading="lazy" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .phone {
    --w: var(--phone-w, 17rem);
    width: var(--w);
    aspect-ratio: 780 / 1688;
    padding: 0.55rem;
    border-radius: 2.6rem;
    background: linear-gradient(145deg, #3b4440, #151a18 55%, #2b332f);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12) inset,
      0 2px 0 rgb(255 255 255 / 0.1) inset,
      0 30px 60px -20px rgb(20 40 28 / 0.45),
      0 12px 24px -12px rgb(0 0 0 / 0.35);
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 2.1rem;
    overflow: hidden;
    background: #fff;
  }
  .shot {
    position: absolute;
    inset: 0;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .shot :global(.dark) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .shot :global(.light) {
      display: none;
    }
    .shot :global(.dark) {
      display: block;
    }
  }
</style>

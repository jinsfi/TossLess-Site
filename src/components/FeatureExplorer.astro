---
import Phone from './Phone.astro';
import addFood from '../assets/screenshots/add-food.png';
import home from '../assets/screenshots/home.png';
import reminder from '../assets/screenshots/reminder.png';
import itemDetail from '../assets/screenshots/item-detail.png';
import stats from '../assets/screenshots/stats.png';
import addFoodDark from '../assets/screenshots/dark/add-food.png';
import homeDark from '../assets/screenshots/dark/home.png';
import reminderDark from '../assets/screenshots/dark/reminder.png';
import itemDetailDark from '../assets/screenshots/dark/item-detail.png';
import statsDark from '../assets/screenshots/dark/stats.png';

// The order here is the order of the steps on the page.
const steps = [
  {
    title: 'Add food in seconds',
    text: 'Scan a barcode, pick from your leftovers, or just type. TossLess fills in how long it keeps.',
    light: addFood,
    dark: addFoodDark,
    alt: 'The TossLess add-food sheet, with Scan, Leftovers and Type options and chicken results from a search.',
  },
  {
    title: 'See what to eat first',
    text: 'Your home screen sorts everything by when it needs eating: today, tomorrow, then the next few days.',
    light: home,
    dark: homeDark,
    alt: 'The TossLess home screen listing foods to use soon, with chicken breast due today and baby spinach due tomorrow.',
  },
  {
    title: 'Get one reminder a day',
    text: 'One notification tells you what to use tonight. No nagging, no pile of alerts.',
    light: reminder,
    dark: reminderDark,
    alt: 'A lock screen notification from TossLess reading: 3 things to use tonight.',
  },
  {
    title: 'Know every item',
    text: 'Open any item to see the days left, then mark it eaten, freeze it, or tossed.',
    light: itemDetail,
    dark: itemDetailDark,
    alt: 'The TossLess detail screen for opened Greek yogurt, showing 2 days left and Eaten, Freeze it, Tossed buttons.',
  },
  {
    title: 'See what you save',
    text: 'Stats show how much food you ate before it expired, and how your waste is trending over time.',
    light: stats,
    dark: statsDark,
    alt: 'The TossLess stats screen showing money saved this month, a streak without tossing food, and eaten versus tossed.',
  },
];
---

<div class="scroller">
  <div class="track">
  <div class="pin">
    <div class="pin-inner wrap">
      <div class="intro">
        <h2>Everything you need, nothing you don't</h2>
        <p>Keep scrolling to see each step in the app.</p>
      </div>
      <div class="layout">
        <ol class="tabs">
          {
            steps.map((s, i) => (
              <li class="tab">
                <span class="num">{i + 1}</span>
                <span class="body">
                  <strong>{s.title}</strong>
                  <span class="text">{s.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <div class="stage">
          <Phone screens={steps} />
        </div>
      </div>
    </div>
  </div>
  </div>

  <div class="triggers" aria-hidden="true">
    {steps.map(() => <div class="trigger" />)}
  </div>
</div>

<style>
  /* --on is 1 when a step is active and 0 when it is not; the scroll timelines animate it. */
  @property --on {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .scroller {
    --page-h: calc(100svh - var(--header));
    position: relative;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    border-block: 1px solid var(--border);
    scroll-snap-align: start;
  }
  .pin {
    min-height: var(--page-h);
    padding-block: 2.5rem;
  }
  .pin-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.6rem, 2svh, 1.25rem);
    min-height: inherit;
  }
  .intro {
    text-align: center;
  }
  .intro h2 {
    margin: 0 0 0.4rem;
    font-size: min(clamp(1.3rem, 5vw, 2.5rem), 4.2svh);
    letter-spacing: -0.02em;
  }
  .intro p {
    margin: 0;
    color: var(--text-2);
  }
  @media (max-height: 50rem) {
    .intro p {
      display: none;
    }
    .intro h2 {
      margin: 0;
    }
  }
  .layout {
    display: grid;
    gap: clamp(0.6rem, 2svh, 1.25rem);
    justify-items: center;
    grid-template-areas:
      'stage'
      'tabs';
  }
  .stage {
    grid-area: stage;
    --phone-w: min(13rem, 24svh);
  }
  .tabs {
    grid-area: tabs;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.3rem, 1svh, 0.5rem);
    width: 100%;
    max-width: 30rem;
  }

  .tab {
    --num: clamp(1.6rem, 3.6svh, 2rem);
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: clamp(0.4rem, 1.2svh, 0.8rem) 1rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--card) calc(var(--on) * 100%), transparent);
    border: 1px solid color-mix(in srgb, var(--border) calc(var(--on) * 100%), transparent);
    box-shadow: 0 10px 30px -18px rgb(30 60 40 / calc(var(--on) * 0.5));
  }
  .num {
    flex: none;
    width: var(--num);
    height: var(--num);
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.95rem;
    background: color-mix(in srgb, var(--primary) calc(var(--on) * 100%), var(--card-subtle));
    color: color-mix(in srgb, var(--on-primary) calc(var(--on) * 100%), var(--text-2));
  }
  .body {
    display: grid;
    gap: 0.2rem;
  }
  strong {
    line-height: var(--num);
  }
  .text {
    color: var(--text-2);
    font-size: clamp(0.85rem, 1.9svh, 1rem);
    line-height: 1.4;
  }

  /* Without scroll-driven animations (or with reduced motion), show a plain static layout. */
  .triggers {
    display: none;
  }
  .stage :global(.shot:where(:not(:first-child))) {
    display: none;
  }

  @media (min-width: 52rem) {
    .layout {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'tabs stage';
      gap: 4rem;
      align-items: center;
      justify-items: stretch;
    }
    .stage {
      --phone-w: min(18rem, 30svh);
      justify-self: center;
    }
    .tabs {
      max-width: none;
      gap: clamp(0.3rem, 1.1svh, 0.75rem);
    }
    .tab {
      padding: clamp(0.4rem, 1.2svh, 1rem) 1.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    @supports (animation-timeline: view()) and (timeline-scope: --a) {
      .scroller {
        timeline-scope: --s1, --s2, --s3, --s4, --s5;
      }
      .track {
        position: absolute;
        inset: 0;
      }
      .pin {
        position: sticky;
        top: var(--header);
        height: var(--page-h);
        min-height: 0;
        padding-block: clamp(0.5rem, 2svh, 1rem);
      }
      .triggers {
        display: block;
      }
      .trigger {
        height: var(--page-h);
        scroll-snap-align: start;
      }
      .trigger:nth-child(1) { view-timeline: --s1 block; }
      .trigger:nth-child(2) { view-timeline: --s2 block; }
      .trigger:nth-child(3) { view-timeline: --s3 block; }
      .trigger:nth-child(4) { view-timeline: --s4 block; }
      .trigger:nth-child(5) { view-timeline: --s5 block; }

      .tab,
      .stage :global(.shot) {
        animation-fill-mode: both;
      }

      /* Each screen fades in over the previous one. Nothing moves; only the content changes. */
      .stage :global(.shot) {
        display: block;
      }
      .stage :global(.shot:nth-child(2)) { animation-name: shot-in; animation-timeline: --s2; }
      .stage :global(.shot:nth-child(3)) { animation-name: shot-in; animation-timeline: --s3; }
      .stage :global(.shot:nth-child(4)) { animation-name: shot-in; animation-timeline: --s4; }
      .stage :global(.shot:nth-child(5)) { animation-name: shot-in; animation-timeline: --s5; }

      .tab:nth-child(1) { animation-name: tab-first; animation-timeline: --s1; }
      .tab:nth-child(2) { animation-name: tab-mid; animation-timeline: --s2; }
      .tab:nth-child(3) { animation-name: tab-mid; animation-timeline: --s3; }
      .tab:nth-child(4) { animation-name: tab-mid; animation-timeline: --s4; }
      .tab:nth-child(5) { animation-name: tab-last; animation-timeline: --s5; }

      /* Phones: only the active step is shown, all stacked in one spot. */
      .tab {
        grid-area: 1 / 1;
        align-self: start;
        opacity: var(--on);
      }
    }
  }

  @media (min-width: 52rem) {
    @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
      @supports (animation-timeline: view()) and (timeline-scope: --a) {
        /* Desktop: every step stays in place; the active one is simply brighter. */
        .tabs {
          min-height: 0;
        }
        .tab {
          grid-area: auto;
          opacity: calc(0.5 + var(--on) * 0.5);
        }
      }
    }
  }

  @keyframes tab-first {
    0%,
    50% {
      --on: 1;
    }
    100% {
      --on: 0;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
  @keyframes tab-mid {
    0% {
      --on: 0;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    50% {
      --on: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    100% {
      --on: 0;
    }
  }
  @keyframes tab-last {
    0% {
      --on: 0;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    50%,
    100% {
      --on: 1;
    }
  }
  /* The next screen fades in over the previous one. */
  @keyframes shot-in {
    0% {
      opacity: 0;
      animation-timing-function: ease-in-out;
    }
    50%,
    100% {
      opacity: 1;
    }
  }
</style>

---
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image = '/og-default.png', type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
// Cloudflare Web Analytics. With no token the snippet is left out (Cloudflare can also inject it for you).
const analyticsToken = site.analytics.cloudflareToken;
const analytics = Boolean(analyticsToken) && analyticsToken !== 'TODO';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#2e7d4f" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} articles`} href="/rss.xml" />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.lang === 'fr' ? 'fr_FR' : 'en_US'} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
  analytics && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })} />
  )
}

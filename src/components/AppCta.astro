---
import { site } from '../config/site';
import WaitlistForm from './WaitlistForm.astro';
import AppStoreBadge from './AppStoreBadge.astro';

// launched: App Store badge. Not launched: the waitlist form, once the Kit form action is set.
const formReady = Boolean(site.kit.formAction) && site.kit.formAction !== 'TODO';
if (!site.app.launched && !formReady) {
  console.warn('[AppCta] site.kit.formAction is not set: showing the "coming soon" text instead of the waitlist form.');
}
---

<section class="cta card">
  {
    site.app.launched ? (
      <>
        <h2>Get TossLess</h2>
        <p>Know what to eat first. Download TossLess on the App Store.</p>
        <AppStoreBadge />
      </>
    ) : (
      <>
        <h2>Get notified when TossLess launches</h2>
        {formReady ? (
          <WaitlistForm />
        ) : (
          <p>
            The waitlist opens shortly. Questions? Write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </p>
        )}
      </>
    )
  }
</section>

<style>
  .cta {
    background: var(--primary-tint);
    margin-block: 2rem;
  }
  h2 {
    margin-top: 0;
  }
  p {
    margin-top: 0;
  }
  .cta > :last-child {
    margin-bottom: 0;
  }
</style>

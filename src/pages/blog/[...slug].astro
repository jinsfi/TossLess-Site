---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

// Drafts are never built: no page, no sitemap entry, no RSS item.
export async function getStaticPaths() {
  const published = await getCollection('blog', ({ data }) => !data.draft);
  return published.map((post) => ({ params: { slug: post.id }, props: { post, published } }));
}

const { post, published } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} published={published}>
  <Content />
</PostLayout>

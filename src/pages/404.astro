---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout noindex title="Page not found" description="That page does not exist. Head back to the TossLess home page or the blog.">
  <div class="wrap page">
    <h1>Page not found</h1>
    <p>We could not find that page. Try one of these:</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/blog/">Blog</a></li>
    </ul>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title="Privacy policy" description="How the TossLess website handles your data, including analytics and, once it opens, the email waitlist.">
  <div class="wrap page prose">
    <h1>Privacy policy</h1>
    <!-- OWNER: add the app's own privacy policy here, then have the full text reviewed. -->
    <p>This page covers the TossLess website. The privacy policy for the app itself will be added here.</p>

    <h2>Analytics</h2>
    <p>
      We use Cloudflare Web Analytics to count visits and see which pages are read. It does not use cookies and does not track
      you across sites.
    </p>

    <h2>Contact</h2>
    <p>Questions about privacy: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
  </div>
</BaseLayout>

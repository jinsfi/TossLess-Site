---
import '../styles/global.css';
import { site } from '../config/site';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  snap?: boolean;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, home = false, snap = false, image, type, noindex } = Astro.props;
const fullTitle = home ? `${site.name} — ${title}` : `${title} · ${site.name}`;
---

<!doctype html>
<html lang={site.lang} class={snap ? 'snap' : undefined}>
  <head>
    <BaseHead title={fullTitle} description={description} image={image} type={type} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
